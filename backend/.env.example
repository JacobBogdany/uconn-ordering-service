# Copy to backend/.env for local development. Keep real credentials out of Git.
APP_ENV=development
DEMO_MODE=true
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_MINUTES=60
DEMO_STUDENT_USER_ID=00000000-0000-4000-8000-000000000001
DEMO_OPERATOR_USER_ID=00000000-0000-4000-8000-000000000002

# Optional until the Supabase project is configured. Use the server-side key only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
